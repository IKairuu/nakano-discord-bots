    {
      "parameters": {
        "jsCode": "function stripHtml(html = '') {\n  return html\n    .replace(/<a[^>]*>[\\s\\S]*?<\\/a>/gi, '')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(p|div|li|h\\d)>/gi, '\\n')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&#(\\d+);/g, (_, n) => String.fromCharCode(n))\n    .replace(/\\[[^\\]]*\\]\\([^)]*\\)/g, '')\n    .replace(/\\[\\s*link\\s*\\]/gi, '')\n    .replace(/\\[\\s*\\]/g, '')\n    .replace(/https?:\\/\\/\\S+/g, '')\n    .replace(/[ \\t]+/g, ' ')\n    .replace(/\\s+([.,!?])/g, '$1')\n    .replace(/\\n\\s*\\n+/g, '\\n')\n    .trim();\n}\n\nfunction dateFormatter(date) {\n  return DateTime.fromISO(date).setZone(\"Asia/Manila\").toFormat(\"ccc, LLL d - h:mm a\")\n}\n\nconst deadlines = $input.first().json.deadline;\nconst events = $('Filter Near Deadlines Events').all()\nvar event_body;\nvar deadline_body;\nif (deadlines.length > 1) {\n  deadline_body = deadlines\n  .map((d, i) => [\n    `${i + 1}. **${stripHtml(d.json.task.title)}**`,\n    `   Description: ${stripHtml(`${d.json.task.description.split(\".\").length > 2 ? `${d.json.task.description.split(\".\")[0]}...` : d.json.task.description}` ?? \"No Description\")}`,\n    `   Due Date: \\`${dateFormatter(d.json.task.due_at)}\\``,\n  ].join('\\n'))\n  .join('\\n\\n');\n\n}\n\nif (events.length >= 1) {\n    event_body = events.map((d, i) => [\n    `${i + 1}. **${stripHtml(d.json.events[i].json.event.title)}**`,\n    `   Description: ${stripHtml(`${d.json.events[i].json.event.description.split(\".\").length > 2 ?  `${d.json.events[i].json.event.description.split(\".\")[0]}...` : d.json.events[i].json.event.description }` ?? \"No description\" )}`,\n    `   Due Date: \\`${dateFormatter(d.json.events[i].json.event.start)}\\``,\n  ].join('\\n'))\n  .join('\\n\\n');\n}\n\nreturn [\n  { json: \n    { \n      deadline: `**Almost Due Deadlines:** ${deadline_body !== undefined ? `\\n\\n${deadline_body}` : \"**None**\"}`,\nevent: `**Almost Due Events:** ${event_body !== undefined ? `\\n\\n${event_body}` : \"**None**\"}`} \n  }\n];"
      },

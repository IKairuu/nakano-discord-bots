        "jsCode": "var deadlines = { \"deadline\": [] }\nfor (const item of $input.all()) {\n  if ( (DateTime.fromISO($json.task.due_at).setZone(\"Asia/Manila\") > DateTime.now().setZone(\"Asia/Manila\") ) && DateTime.fromISO($json.task.due_at).setZone(\"Asia/Manila\")  <= DateTime.now().setZone(\"Asia/Manila\").plus({ days: 4 })) {\n    deadlines[\"deadline\"].push(item)\n  }\n}\n\nreturn deadlines;"
